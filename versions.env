# Pinned versions of every upstream component.
# Sourced by scripts/*.sh (bash) and parsed by cmake/NLVersions.cmake (KEY=VALUE, no spaces, no quotes).
# When you bump anything here, bump NL_BUILD_NUMBER too (release tag lwjgl-<LWJGL_VERSION>-nl<NL_BUILD_NUMBER>).

NL_BUILD_NUMBER=1

# ---- Android target ----------------------------------------------------------
ANDROID_API=29
NDK_VERSION=r28c
NDK_REVISION=28.2.13676358
NDK_LINUX_URL=https://dl.google.com/android/repository/android-ndk-r28c-linux.zip
NDK_LINUX_SHA1=a7b54a5de87fecd125a17d54f73c446199e72a64
NDK_LINUX_SIZE=722261334

# ---- LWJGL 3.3.3 (BSD-3-Clause) — https://github.com/LWJGL/lwjgl3 -------------
LWJGL_VERSION=3.3.3
LWJGL_URL=https://github.com/LWJGL/lwjgl3/archive/refs/tags/3.3.3.tar.gz
LWJGL_SHA256=381a386688a5f5109a0edf2395adfee3cc62031929bf0ddbbd39fd356f647447
LWJGL_DIR=lwjgl3-3.3.3

# ---- libffi (MIT) — linked statically into liblwjgl.so and libjnidispatch.so ----
# 3.4.4 is the libffi release LWJGL 3.3.3's bundled ffi.h is based on; JNA 5.14.0 also bundles 3.4.4.
LIBFFI_VERSION=3.4.4
LIBFFI_URL=https://github.com/libffi/libffi/releases/download/v3.4.4/libffi-3.4.4.tar.gz
LIBFFI_SHA256=d66c56ad259a82cf2a9dfc408b32bf5da52371500b84745f7fb8b645712df676
LIBFFI_DIR=libffi-3.4.4

# ---- FreeType (FTL chosen, not GPLv2) — libfreetype.so for lwjgl-freetype ------
# LWJGL 3.3.3's FreeType binding targets 2.13.2 (FREETYPE_MAJOR/MINOR/PATCH in FreeType.java).
FREETYPE_VERSION=2.13.2
FREETYPE_URL=https://downloads.sourceforge.net/project/freetype/freetype2/2.13.2/freetype-2.13.2.tar.xz
FREETYPE_URL_FALLBACK=https://download.savannah.gnu.org/releases/freetype/freetype-2.13.2.tar.xz
FREETYPE_SHA256=12991c4e55c506dd7f9b765933e62fd2be2e06d421505d7950a132e4f1bb484d
FREETYPE_DIR=freetype-2.13.2

# ---- HarfBuzz (MIT) — linked into libfreetype.so, as in LWJGL's own FreeType build ----
# LWJGL 3.3.3's HarfBuzz binding targets 8.2.0 (HB_VERSION_* in HarfBuzz.java).
HARFBUZZ_VERSION=8.2.0
HARFBUZZ_URL=https://github.com/harfbuzz/harfbuzz/releases/download/8.2.0/harfbuzz-8.2.0.tar.xz
HARFBUZZ_SHA256=8cb7117a62f42d5ad25d4a697e1bbfc65933b3eed2ee7f247203c79c9f1b514c
HARFBUZZ_DIR=harfbuzz-8.2.0

# ---- jemalloc (BSD-2-Clause) — libjemalloc.so for lwjgl-jemalloc ----------------
JEMALLOC_VERSION=5.3.0
JEMALLOC_URL=https://github.com/jemalloc/jemalloc/releases/download/5.3.0/jemalloc-5.3.0.tar.bz2
JEMALLOC_SHA256=2db82d1e7119df3e71b7640219b6dfe84789bc0537983c3b7ac4f7189aecfeaa
JEMALLOC_DIR=jemalloc-5.3.0

# ---- JNA (Apache-2.0 chosen, not LGPL-2.1) — libjnidispatch.so ------------------
JNA_VERSION=5.14.0
JNA_URL=https://github.com/java-native-access/jna/archive/refs/tags/5.14.0.tar.gz
JNA_SHA256=b8a51f4c97708171fc487304f98832ce954b6c02e85780de71d18888fddc69e3
JNA_DIR=jna-5.14.0
# Native interface version and API checksum of JNA 5.14.0 (common.xml: jni.version / jni.md5).
JNA_JNI_VERSION=7.0.0
JNA_JNI_MD5=5fb98531302accd485c534c452dd952a
